LANGUAGES_LIST = list(PAPERS_BY_LANGUAGE.keys())

def get_all_papers_flat():
    flat = {}
    for lang, papers in PAPERS_BY_LANGUAGE.items():
        for paper, cities in papers.items():
            flat[f"{paper}"] = cities
    return flat
